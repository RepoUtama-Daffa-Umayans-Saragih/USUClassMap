APP_NAME=USUClassMap
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://usuclassmap.usu.ac.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Production Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usuclassmap
DB_USERNAME=usuclassmap_user
DB_PASSWORD=SecureProductionPassword123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=usuclassmap_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.usu.ac.id
MAIL_PORT=587
MAIL_USERNAME=noreply@usu.ac.id
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@usu.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# Semantic Web & Apache Jena Fuseki Configuration
FUSEKI_URL=http://127.0.0.1:3030
FUSEKI_DATASET=usuclassmap
SPARQL_TIMEOUT=5

VITE_APP_NAME="${APP_NAME}"
