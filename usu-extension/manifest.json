{
  "manifest_version": 3,
  "name": "USUClassMap Sync",
  "version": "1.0",
  "description": "Ekstensi sinkronisasi jadwal kuliah otomatis dari portal SATU USU ke sistem USUClassMap.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://satu.usu.ac.id/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "USUClassMap Sync"
  }
}
